# Copie para .env e preencha. Tudo aqui é público (vai dentro do site).

# Endereço final do site, sem barra no fim. Sem ele, o site não publica canonical nem sitemap.
VITE_URL_DO_SITE=
# WhatsApp de contato, só números, com 55 e DDD (ex.: 5551999999999).
VITE_CONTATO_WHATSAPP=
# E-mail de contato (usado se não houver WhatsApp).
VITE_CONTATO_EMAIL=
