{
  "expo": {
    "name": "Talhio",
    "slug": "talhio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talhio",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.talhio.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "O Talhio transforma sua fala em texto para enviar a pergunta ao assistente.",
        "NSMicrophoneUsageDescription": "O Talhio usa o microfone para você perguntar ao assistente por voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15321F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.talhio.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15321F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "color": "#2E6A39"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Talhio usa o microfone para você perguntar ao assistente por voz.",
          "speechRecognitionPermission": "O Talhio transforma sua fala em texto para enviar a pergunta ao assistente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a9dc50af-98b6-48fa-a9d5-1f757fbb5830"
      }
    }
  }
}
