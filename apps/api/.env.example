# Copie para .env (que fica fora do Git) e preencha. A API lê este arquivo ao subir.

# Porta da API (3333 para não bater com outros projetos em 3000)
PORT=3333
# fake = dados falsos | deere = John Deere de verdade (login OAuth pronto; leitura dos dados em construção)
DEERE_PROVEDOR=fake
# Organização do administrador criado na subida
ORG_ID=org-demo

# Banco: Postgres de verdade. Sem esta linha, usa o banco embutido em apps/api/.dados (só para desenvolvimento).
# Exemplo: postgres://usuario:senha@localhost:5432/talhio
DATABASE_URL=

# --- Segurança (estas três e DATABASE_URL são OBRIGATÓRIAS com NODE_ENV=production) ---
# Segredo que assina os tokens. Gere um: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Login do administrador (senha com pelo menos 10 caracteres)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# Assistente de IA (aba IA do app). Crie a chave em https://console.anthropic.com e cole aqui.
# Sem chave, o app mostra que o assistente não foi ligado.
ANTHROPIC_API_KEY=
# Modelo usado nas respostas
ANTHROPIC_MODELO=claude-haiku-5-5

# Só se houver um site acessando a API pelo navegador (separe por vírgula). O app não precisa.
CORS_ORIGENS=
# 1 quando a API fica atrás de um proxy/HTTPS que repassa o IP real (produção)
ATRAS_DE_PROXY=0

# Qualquer pessoa pode criar conta e fazenda pelo app. 0 = fecha o cadastro.
CADASTRO_ABERTO=1
# Conta nova espera a nossa aprovação antes de entrar. Sem valor: ligado em produção, desligado no desenvolvimento.
# CADASTRO_COM_APROVACAO=1
# Chave de quem aprova (24+ caracteres). Sem ela ninguém consegue aprovar. Uso: ./infra/aprovar.sh
# APROVACAO_CHAVE=

# E-mail da conta de demonstração (do revisor da Apple): a fazenda dela lê dados de exemplo, sem John Deere nem WhatsApp. A conta precisa existir.
# DEMO_EMAIL=

# --- John Deere (só com DEERE_PROVEDOR=deere). Chaves do app em developer.deere.com > My Applications ---
# NUNCA coloque estas chaves no app, no site, no Git ou no chat.
DEERE_CLIENT_ID=
DEERE_CLIENT_SECRET=
# Sandbox por padrão. Produção: https://partnerapi.deere.com/platform
DEERE_BASE_URL=https://sandboxapi.deere.com/platform
# Lista de máquinas (Equipment API). Só mude se a Deere indicar outro endereço para o sandbox.
DEERE_EQUIPAMENTOS_URL=https://equipmentapi.deere.com/isg
# API ISO 15143-3 (combustível acumulado). A Deere só publica o endereço do sandbox (https://sandboxaemp.deere.com).
# Deixe vazio: o servidor testa os endereços de produção conhecidos e o log mostra qual respondeu.
# DEERE_AEMP_URL=
# Igual ao cadastrado no portal, letra por letra. Local: http://localhost:9090/callback não serve (a rota é desta API).
DEERE_REDIRECT_URI=https://api.talhio.com.br/v1/deere/callback
# Chave que cifra os tokens da Deere no banco (32+ caracteres). Gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DEERE_CRIPTO_CHAVE=
# Escopos pedidos no login; precisam estar entre as APIs aprovadas no portal.
DEERE_ESCOPOS=offline_access ag1 ag2 ag3 eq1 org1 org2 work2
# Para onde o navegador volta (o app abre por este esquema).
APP_RETORNO_DEERE=talhio://deere

# WhatsApp da fazenda. "baileys" conecta de verdade; sem isto, simula (dev).
WHATSAPP_PROVEDOR=fake
# Cifra as credenciais do WhatsApp no banco (32+ caracteres). Obrigatória com baileys.
WHATSAPP_CRIPTO_CHAVE=
# Redis das credenciais e chaves do WhatsApp (redis://... ou rediss://... com TLS). Obrigatório com baileys.
REDIS_URL=
# "1" liga a ESTIMATIVA de litros pela queda do nível do tanque quando o motor não informa. Padrão 0: só entra
# no relatório o combustível que o motor informa (export ou ISO 15143-3); sem ele, "sem leitura".
COMBUSTIVEL_PELO_TANQUE=0
